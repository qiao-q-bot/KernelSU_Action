# =========================
# 基础
# =========================
CONFIG_ENV=config.env

ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

# =========================
# 4.19 fajita 内核源码
# ⚠️ 换成你自己的 4.19 仓库
# =========================
KERNEL_SOURCE=https://github.com/qiao-q-bot/Dynamic_kernel_4.19_oneplus_sdm845
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=vendor/fajita_defconfig

KERNEL_IMAGE_NAME=Image

# =========================
# 编译器（4.19 推荐）
# =========================
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/llvm/llvm-project
CUSTOM_CLANG_BRANCH=release/12.x
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# 强制关闭 LLVM IAS（你本地已经踩过这个坑）
CUSTOM_CMDS:LLVM_IAS=0

# =========================
# GCC 4.9（必须）
# =========================
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=true
CUSTOM_GCC_64_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9
CUSTOM_GCC_64_BRANCH=lineage-17.1
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9
CUSTOM_GCC_32_BRANCH=lineage-17.1
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =========================
# KernelSU / SukiSU
# ⚠️ 你已经在源码里集成了
# =========================
ENABLE_KERNELSU=false
APPLY_KSU_PATCH=false

# =========================
# 4.19 必关项
# =========================
DISABLE_LTO=true
disable_CC_WERROR=true

# =========================
# AnyKernel3 打包
# =========================
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3
CUSTOM_ANYKERNEL3_BRANCH=master

# =========================
# OnePlus 6T
# =========================
NEED_DTBO=true
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/LineageOS/android_device_oneplus_fajita/raw/lineage-18.1/boot.img

# =========================
# 加速
# =========================
ENABLE_CCACHE=true
