CONFIG_ENV=config.env

# 一加6T（fajita）4.9内核源码，可根据实际源码调整
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sdm845
KERNEL_SOURCE_BRANCH=oneplus/SDM845_P_9.0
KERNEL_CONFIG=vendor/fajita_defconfig  # 一加6T官方配置
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
# 4.9内核建议使用ld.gold，lld可能存在兼容性问题
# EXTRA_CMDS:LD=ld.lld

# Clang配置（4.9内核推荐使用较旧版本clang）
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# 适合4.9内核的AOSP clang版本
CLANG_BRANCH=android-9.0.0_r45
CLANG_VERSION=r353983c

# GCC配置（4.9内核推荐使用linaro 7.x版本）
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=true
CUSTOM_GCC_64_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-7.3.1
CUSTOM_GCC_64_BRANCH=lineage-16.0
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-7.3.1
CUSTOM_GCC_32_BRANCH=lineage-16.0
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# KernelSU配置（按需开启）
ENABLE_KERNELSU=false
KERNELSU_TAG=v0.9.5
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# 4.9内核配置优化
DISABLE-LTO=true  # 4.9内核通常不支持LTO
disable_CC_WERROR=true  # 关闭警告转错误，避免旧代码编译失败
ADD_KPROBES_CONFIG=true  # 开启kprobes支持
ADD_OVERLAYFS_CONFIG=true  # 开启overlayfs支持
APPLY_KSU_PATCH=false
REMOVE_UNUSED_PACKAGES=true

# AnyKernel3配置（一加6T专用）
USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3
CUSTOM_ANYKERNEL3_BRANCH=master

# Ccache加速编译
ENABLE_CCACHE=true

# 一加6T需要DTBO镜像
NEED_DTBO=true

# 构建boot镜像配置
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/LineageOS/android_device_oneplus_fajita/raw/lineage-16.0/boot.img
